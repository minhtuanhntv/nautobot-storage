{# === NTP Configuration for Cisco IOS === #}
{% set ntp_data = config_context.get("ntp", []) %}

{% if ntp_data is iterable and ntp_data is not string %}
  {% for server in ntp_data %}
    {% if server is mapping %}
      {# Cấu trúc: { "ip": "1.1.1.1", "prefer": true } #}
      {% set ip = server.get("ip") %}
      {% set prefer = server.get("prefer", false) %}
      {% if ip %}
        {% if prefer %}
ntp server {{ ip }} prefer
        {% else %}
ntp server {{ ip }}
        {% endif %}
      {% endif %}
    {% elif server is string %}
      {# Cấu trúc đơn giản: "1.1.1.1" #}
ntp server {{ server }}
    {% endif %}
  {% endfor %}
{% endif %}
